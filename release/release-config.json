    { "id": "darwin-x64", "os": "darwin", "architecture": "x64", "minimum_os": "13.0", "watcher_package": "@parcel/watcher-darwin-x64@2.6.0" },
    { "id": "linux-arm64-gnu", "os": "linux", "architecture": "arm64", "libc": "glibc", "minimum_libc": "2.31", "watcher_package": "@parcel/watcher-linux-arm64-glibc@2.6.0" },
    { "id": "linux-x64-gnu", "os": "linux", "architecture": "x64", "libc": "glibc", "minimum_libc": "2.31", "watcher_package": "@parcel/watcher-linux-x64-glibc@2.6.0" },
    { "id": "win32-x64", "os": "win32", "architecture": "x64", "minimum_os": "10.0.19041", "watcher_package": "@parcel/watcher-win32-x64@2.6.0" }
  ],
  "production_packages": [
    "urdira",
    "@urdira/cli",
    "@urdira/mcp",
    "@urdira/daemon",
    "@urdira/engine",
    "@urdira/embedding-local",
    "@urdira/storage",
    "@urdira/security",
    "@urdira/plugin-sdk",
    "@urdira/plugin-javascript-typescript",
