  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@huggingface/transformers": "4.2.0",
    "@parcel/watcher": "2.6.0",
    "adm-zip": "0.6.0",
    "isomorphic-git": "1.40.5",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "eslint": "9.39.5"
  },
  "semantic_model": {
    "model_id": "Xenova/all-MiniLM-L6-v2",
